# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env lên git.
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smartspend
DB_USER=postgres
DB_PASSWORD=postgres
# Hoặc dùng một chuỗi kết nối duy nhất (ưu tiên hơn các dòng DB_* ở trên) - vd chuỗi "Session pooler" của Supabase:
# DATABASE_URL=postgresql://postgres.xxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Bật SSL khi kết nối CSDL trên cloud (DATABASE_URL tự bật SSL nếu không ghi sslmode=disable)
DB_SSL=false
# Chuỗi bí mật ký JWT, tối thiểu 32 ký tự ngẫu nhiên (vd: openssl rand -hex 32)
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=30
# Nơi lưu ảnh giao dịch: local (thư mục trên máy) hoặc supabase (Supabase Storage, dùng khi chạy trên cloud)
STORAGE_DRIVER=local
# Thư mục kho ảnh riêng tư khi STORAGE_DRIVER=local (không public ra web)
UPLOAD_DIR=./storage/attachments
# Khi STORAGE_DRIVER=supabase: địa chỉ project, khóa bí mật (secret / service_role) và tên bucket riêng tư
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=attachments
# true khi chạy sau proxy của cloud (Render) để lấy đúng IP người dùng cho giới hạn tần suất
TRUST_PROXY=false
# Gemini (để trống thì server dùng bộ phân tích dự phòng không cần AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_PARSE_PER_DAY=50
AI_ANALYZE_PER_DAY=3
# Firebase Cloud Messaging: đường dẫn file service account JSON (để trống thì tắt thông báo đẩy)
FCM_SERVICE_ACCOUNT=
# Chạy tác vụ định kỳ (dự báo, phân tích hàng tuần)
ENABLE_SCHEDULER=true
# Giới hạn số lần đăng ký mỗi IP mỗi giờ (chống tạo tài khoản hàng loạt)
REGISTER_PER_IP_PER_HOUR=5
# Giới hạn số yêu cầu mỗi phút cho một người dùng
REQUESTS_PER_MINUTE=120
